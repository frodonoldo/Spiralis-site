# Spiralis — configuração de servidor (Apache/LiteSpeed, hospedagem Hostinger)
# Este arquivo precisa ficar na raiz de public_html para ter efeito.

# ── ENDEREÇO ÚNICO ────────────────────────────────
# Hoje spiraliscompany.com.br e www.spiraliscompany.com.br respondem os dois
# com 200, sem redirecionamento. Para o Google são duas páginas idênticas em
# endereços diferentes, e ele divide a força de ranqueamento entre elas.
# Tudo passa a cair no endereço sem www, que é o mesmo declarado no canonical
# e no og:url. 301 é permanente: sinaliza ao buscador que ele deve transferir
# o histórico para o destino, coisa que um 302 não faz.
#
# São duas regras separadas de propósito. Na hospedagem compartilhada o SSL
# costuma terminar num proxy antes do Apache, e ali %{HTTPS} lê "off" mesmo
# numa conexão https: uma regra só, olhando apenas %{HTTPS}, redirecionaria
# para https eternamente e tiraria o site do ar. Por isso a checagem aceita
# também o cabeçalho que o proxy repassa.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) força https, a menos que o Apache OU o proxy já indiquem https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

  # 2) tira o www, preservando o caminho e a query
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]
</IfModule>

# ── CACHE ─────────────────────────────────────────
# O HTML nunca é cacheado e os arquivos estáticos são cacheados por um ano.
# Essa assimetria é de propósito: cachear o index.html faria um deploy novo
# ficar invisível para quem já visitou, que foi exatamente a confusão do dia
# em que a medição não aparecia. Imagem, fonte e script podem durar porque
# trocam de nome quando mudam de verdade.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── COMPRESSÃO ────────────────────────────────────
# O index.html tem cerca de 250 KB de HTML, CSS e JS num arquivo só, e o GSAP
# vem junto. Comprimido, isso cai para perto de um quinto do tamanho.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── SEGURANÇA ─────────────────────────────────────
# Impede que o site seja embutido em iframe de terceiro (clickjacking) e que
# o navegador tente adivinhar o tipo de um arquivo servido.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Listagem de diretório desligada: sem isto, uma pasta sem index vira índice
# navegável dos arquivos.
Options -Indexes
